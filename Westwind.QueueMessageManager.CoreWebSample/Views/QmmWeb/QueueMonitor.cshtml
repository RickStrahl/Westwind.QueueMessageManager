@using Westwind.QueueManager.CoreWebSample
@{
    ViewData["Title"] = "Queue Monitor";
}
@section Headers {
    
	<link href="~/css/QueueMonitor.css" rel="stylesheet" />

}
<div id="queueMonitorApp">
<div class="monitor-page">
    <header class="monitor-header">
        <div>
            <h1>Queue Monitor  <span style="font-size: 0.55em; font-weight: normal">v@(qmmApp.Version)</span></h1>            
        </div>
        <div class="connection-pill" :class="connectionClass">
            {{ connectionStatus }}
        </div>
    </header>

    <section class="control-grid">
        <div class="field">            
            <select id="queueSelect" v-model="activeQueue" @@change="onQueueChanged">
                <option v-for="queue in queueOptions" :key="queue.value" :value="queue.value">
                    {{ queue.text }}
                </option>
            </select>
        </div>

        <div class="field two-up" :hidden="!controllerStatus.queueName">
            <div>
                <label for="threadCount">Threads:&nbsp; </label>
                <input id="threadCount" type="number" min="1" max="50" 
                       v-model.number="controllerStatus.threadCount"  />
            </div>
            <div>
                <label for="waitInterval">Wait (ms):&nbsp; </label>
                <input id="waitInterval" type="number" min="10" style="width: 6em"
                       v-model.number="controllerStatus.waitInterval"  />
            </div>
            <button class="btn btn-primary btn-sm"
                    style="padding: 0.1em 0.6em !important;"
                    @@click="updateControllerStatus" :disabled="!controllerStatus.queueName">Update</button>
        </div>

        <div class="button-row">
            <button class="btn btn-primary btn-sm" @@click="reloadMessages">Reload</button>
            <button class="btn btn-primary btn-sm" @@click="refreshStatus">Refresh Status</button>            
            <button class="btn btn-success btn-sm" @@click="startService" v-if="controllerStatus.paused">Start</button>
            <button class="btn btn-danger btn-sm" @@click="stopService" v-else>Stop</button>
            <button class="btn btn-outline-secondary btn-sm" @@click="clearMessages">Clear</button>

            <div style="margin-left: 3em; display: block;">                
                <div >
                    <strong>Waiting in Queues:</strong> {{ waitingMessages }}
                </div> 
            </div>
        </div>
    </section>

    <section class="message-list">
        <article class="message-item" v-for="item in visibleMessages" :key="item.key" @@click="openMessage(item)" :class="rowClass(item.status)">
            <div class="message-top-row">
                <div class="status-chip" :class="rowClass(item.status)">{{ item.status || "Info" }}</div>     
                <div>
                     <b>{{ item.queueName || "" }}</b>
                     &bull; <b class="text-success">{{ item.action }}</b>
                </div>
                <div class="message-id">                    
                    {{ item.elapsed ? item.elapsed + " &bull; " : "" }}                    
                    {{ item.time || "" }} &bull; <small>{{ item.id || "(no id)" }}</small>                                        
                </div>
            </div>
            <pre v-if="item.message" class="message-body">{{ item.message }}</pre>
        </article>
        <div v-if="visibleMessages.length === 0" class="empty-message">No messages yet for the selected queue.</div>
    </section>

    <div class="modal-mask" v-if="selectedMessage" @@click.self="selectedMessage = null">
        <section class="modal-panel">
            <header>
                <h2>Queue Item Details</h2>
                <button class="btn" @@click="selectedMessage = null">Close</button>
            </header>
            <div class="meta-grid">
                <div><strong>ID</strong><span>{{ selectedMessage.id }}</span></div>
                <div><strong>Status</strong><span>{{ selectedMessage.status }}</span></div>
                <div><strong>Queue</strong><span>{{ selectedMessage.queueName }}</span></div>
                <div><strong>Date</strong>
                    <span>{{ selectedMessage.date }}</span>
                    <small>
                    <span v-if="selectedMessage.completed">complete: {{ selectedMessage.completed }}</span>
                    <span v-if="selectedMessage.elapsed"> &bull; {{ selectedMessage.elapsed }}</span>
                    </small>
                </div>
            </div>
            <h3>Message</h3>
            <pre>{{ selectedMessage.message }}</pre>
            <h3>Payload</h3>
            <pre>{{ selectedMessage.xml }}</pre>
            <pre>{{ JSON.stringify(selectedMessage) }}</pre>
        </section>
    </div>



</div>
<section class="status-strip">
    <div class="status-message" :title="lastStatusMessage">
        <i class="fas fa-circle"
           :class="{'text-success': !lastStatusMessage || statusType === 'success', 'text-danger': statusType === 'error', 'text-warning': statusType === 'progress'}"
        ></i>
           
        {{ lastStatusMessage || "Ready" }}
    </div>
</section>

</div>

@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="~/js/QueueMonitor.js"></script>
}
