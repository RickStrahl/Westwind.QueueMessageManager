@using System.Runtime.InteropServices
@using Westwind.MessageQueueing
@addTagHelper *, Westwind.AspNetCore

@model Westwind.MessageQueueing.Hosting.AdminViewModel
@{

	bool isIis = false;
	var processName = System.Diagnostics.Process.GetCurrentProcess().ProcessName;
	if (processName.Contains("w3svc", StringComparison.OrdinalIgnoreCase)) {
		isIis = true;	
	}
}
@section Headers {
	<style>
		html, body { 
			height:  100%;
		}
	</style>
}
<div class="container">
    
	<h1 class="page-header-text mb-0">
		<i class="fad fa-gears"></i>
		Web Store Configuration
        
		<a href="queuemonitor" title="Back to main Admin page"
		   class="btn btn-secondary btn-sm float-end">
			<i class="fad fa-home-alt text-warning"></i>
		</a>

	</h1>

	<div class="mt-1 mb-3 byline small">
		v@(Model.ApplicationVersion) &nbsp;<small style="font-size: 0.75em">(@Model.ApplicationDate)</small> &bull;
		@qmmApp.EnvironmentName &bull;
		@RuntimeInformation.FrameworkDescription &bull; @RuntimeInformation.OSArchitecture &bull;
		exe: @System.Diagnostics.Process.GetCurrentProcess().ProcessName

		@if (isIis)
		{
			<div class="float-end">
				<button type="submit" id="btnRestartApplication" name="btnRestartApplication" class="btn btn-sm btn-primary">
					<i class="fas fa-refresh"></i>
					Restart Application
				</button>
			</div>
		}
	</div>

	<error-display error-display-model="@Model.ErrorDisplay" class="mt-3 mb-4" >
	</error-display>
    
	<form method="post" action="">	
			
		<h3 class="mt-4">Queue Container Configuration</h3>
		<textarea 
            class="form-control"
            placeholder="Configuration text"
            asp-for="ContainerConfigurationJson"
                    spellcheck="false" autocomplete="off"
            style="font-family: monospace; height:  60em; font-size: 1em">
		</textarea> 

		<div class="mt-2 mb-2">
			<button type="submit" id="btnWriteContainerConfiguration" name="btnWriteContainerConfiguration" class="btn btn-primary">
				<i class="fas fa-circle-arrow-right"></i>
				Write Container Configuration
			</button>			
		</div>
    
	</form>
</div>